{
  "name": "pokemon-aco",
  "productName": "Pokemon ACO",
  "version": "1.1.0",
  "description": "Windows desktop auto-checkout for Pokemon TCG products using each retailer's normal purchase flow.",
  "author": {
    "name": "mikechen04"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "catalog:feed": "node scripts/catalog/run.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.50.0",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
